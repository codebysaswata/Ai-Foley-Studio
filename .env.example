# Copy to .env manually and set a unique random bearer token (24+ characters).
AI_FOLEY_API_HOST=127.0.0.1
AI_FOLEY_API_PORT=8000
AI_FOLEY_API_TOKEN=replace-with-a-random-secret-at-least-24-characters
# Exact browser origin(s), comma separated. Example: http://localhost:3000
AI_FOLEY_CORS_ORIGINS=http://localhost:3000
AI_FOLEY_API_DATA_DIR=ai_foley_studio/data
AI_FOLEY_API_MAX_UPLOAD_BYTES=536870912
AI_FOLEY_API_MAX_CONTEXT_BYTES=2097152
AI_FOLEY_API_MAX_VIDEO_SECONDS=300
AI_FOLEY_API_MAX_VIDEO_PIXELS=8294400
AI_FOLEY_API_MAX_QUEUED_JOBS=3
AI_FOLEY_API_RETENTION_DAYS=14
AI_FOLEY_FFMPEG=ffmpeg
AI_FOLEY_FFPROBE=ffprobe
